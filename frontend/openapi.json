          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "body_excerpt",
          "html_url",
          "labels",
          "comments_count",
          "created_at",
          "updated_at",
          "is_available",
          "unavailable_reason",
          "difficulty_label",
          "level",
          "kind",
          "repo",
          "score_breakdown",
          "body",
          "body_truncated",
          "author_association",
          "assignee_count",
          "has_linked_pr",
          "last_checked_at"
