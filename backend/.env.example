# Copy to backend/.env and fill in. Never commit .env.

# Local Postgres from scripts/dev-db.sh (port 5433, trust auth)
DATABASE_URL=postgresql+psycopg://firstpr@localhost:5433/firstpr

# Fine-grained personal access token, public repos read-only (no extra scopes needed).
# Without it the sync runs unauthenticated: 60 requests/hour.
GITHUB_TOKEN=

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
GITHUB_MAX_RETRIES=5
GITHUB_MAX_RATE_LIMIT_WAIT_S=900

# --- GitHub sign-in (OAuth App: github.com/settings/developers -> New OAuth App) ---
# Callback URL to register on GitHub: {APP_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Encrypts stored GitHub tokens. Generate once and keep it secret:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# The site's public address (the frontend, which forwards /api to the backend)
APP_URL=http://localhost:5173

# --- Error monitoring (optional): sentry.io -> project (FastAPI) -> Client Keys (DSN) ---
# Empty = Sentry off. Locally you normally leave this empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
