                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DifficultyBreakdown": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "easy",
                  "medium",
                  "hard"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "method": {
            "type": "string",
            "enum": [
              "model_v1",
              "baseline_heuristic"
            ],
            "title": "Method",
            "default": "baseline_heuristic"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "label",
          "score",
          "reasons"
        ],
        "title": "DifficultyBreakdown"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
